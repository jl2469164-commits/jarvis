# Required: local CosyVoice. Mac steps (download ~2 GB, where to put it,
# prompt wav, cpu vs mps vs Intel): docs/cosyvoice.md
# Weights stay outside git. CPU works and is slow (seconds per sentence).
# On a Mac start with cpu. mps is Apple Silicon only and best-effort.
# cuda is NVIDIA, not a Mac.
COSYVOICE_REPO=/Users/you/src/CosyVoice
COSYVOICE_MODEL_DIR=/Users/you/models/CosyVoice2-0.5B
COSYVOICE_PROMPT_WAV=/Users/you/models/jarvis-prompt.wav
COSYVOICE_PROMPT_TEXT=The words spoken in prompt.wav.
COSYVOICE_DEVICE=cpu
# COSYVOICE_SPEAKER=jarvis
# COSYVOICE_TIMEOUT=120

# Unused. Speech does not read this. Not shown in Settings.
# FISH_API_KEY=your-fish-audio-api-key-here

# Required for the Grok voice-brain path (https://console.x.ai/).
# Default preflight fails when this is missing or still the placeholder.
# brain.py does not call api.x.ai yet; the key is what that follow-up reads.
XAI_API_KEY=your-xai-api-key-here

# Required for the Aider construction path: `aider` on PATH, plus at least
# one provider key below. Uncomment the one Aider should use. Placeholders
# only — do not put a real key in this file.
# OPENAI_API_KEY=your-openai-api-key-here
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
# GOOGLE_API_KEY=your-google-api-key-here
# AZURE_API_KEY=your-azure-api-key-here
# COHERE_API_KEY=your-cohere-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
#   Aider only. Preflight still warns: Claude children scrub every ANTHROPIC_*.

# Claude Code is legacy for this fork's default preflight. brain.py and
# run_executor.py still spawn `claude -p` on your subscription login until
# the Grok/Aider follow-up. Those checks run only with
# run_checks(include_legacy_claude=True). No Anthropic API key is required
# for that login, and any ANTHROPIC_* variable set here is hidden from
# Claude children.

# Optional: which model the brain runs (default sonnet; always passed explicitly
# to `claude -p --model` today). The Grok follow-up will read the same name.
# JARVIS_BRAIN_MODEL=sonnet

# Unused. Not shown in Settings.
# FISH_VOICE_ID=your-fish-voice-id-here

# Optional: Your name (JARVIS will address you by name)
# USER_NAME=Tony

# Optional: Whether to skip Claude CLI permission prompts on subprocess calls.
# Defaults to "true" because JARVIS is voice-driven and cannot respond to
# interactive permission prompts (they would silently hang the subprocess).
# Set to "false" to require explicit permission prompts — only useful when
# running JARVIS interactively in a Terminal you can see and respond to.
# JARVIS_SKIP_PERMISSIONS=true

# Optional: Override the auto-detected weather location.
# By default, JARVIS uses your public-IP location (via ipwho.is) and reports
# Fahrenheit. Set these to pin a specific location:
# WEATHER_LOCATION_LABEL=London
# WEATHER_LATITUDE=51.5072
# WEATHER_LONGITUDE=-0.1276
# WEATHER_UNIT=fahrenheit  # or "celsius"
